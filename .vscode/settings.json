{
  "files.associations": {
    "renovate.json": "jsonc",
    ".envrc*": "shellscript"
  },

  "editor.semanticHighlighting.enabled": true,

  "explorer.fileNesting.patterns": {
    ".envrc.project": ".envrc",
    "flake.nix": "flake.lock,treefmt.toml",
    "README.md": "*.md,LICENSE",
    "settings.gradle.kts": "build.gradle.kts,gradle.properties,gradle.lockfile,settings-gradle.lockfile",
    "package.json": "package-lock.json,.npmrc"
  },

  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/": true,
    "https://docs.renovatebot.com/": true,
    "https://opencode.ai/": true,
    "https://models.dev/": true
  },

  // rust-lang.rust-analyzer
  "rust-analyzer.server.path": "rust-analyzer",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // golang.go
  "go.alternateTools": {
    "gopls": "gopls"
  },
  "gopls": { "ui.semanticTokens": true },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },

  // jetbrains.kotlin-server
  "[kotlin]": {
    "editor.defaultFormatter": "jetbrains.kotlin-server"
  },

  // TypeScriptTeam.native-preview
  "js/ts.experimental.useTsgo": true,

  // esbenp.prettier-vscode
  "prettier.enable": false,

  // oxc.oxc-vscode
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always" // oxlint
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // redhat.vscode-yaml
  "yaml.format.enable": false,

  // jnoortheen.nix-ide
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "(builtins.getFlake (builtins.toString ./.)).outputs.nixpkgs.${builtins.currentSystem}"
      },
      "formatting": {
        "command": ["nixfmt"]
      }
    }
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  }
}
