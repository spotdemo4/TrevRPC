{
  "files.associations": {
    ".envrc*": "shellscript",
    // bufbuild.vscode-buf claims these, and one is a Forgejo workflow
    "buf.yaml": "yaml",
    "buf.gen.yaml": "yaml"
  },

  "editor.semanticHighlighting.enabled": true,

  "explorer.fileNesting.patterns": {
    ".envrc.project": ".envrc",
    "flake.nix": "flake.lock,treefmt.toml",
    "README.md": "*.md,LICENSE",
    "settings.gradle.kts": "build.gradle.kts,gradle.properties,gradle.lockfile,settings-gradle.lockfile",
    "package.json": "package-lock.json,.npmrc",
    "pyproject.toml": "uv.lock",
    "gleam.toml": "manifest.toml",
    "rebar.config": "rebar.lock"
  },

  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/": true,
    "https://docs.renovatebot.com/": true,
    "https://opencode.ai/": true,
    "https://models.dev/": true
  },

  // rust-lang.rust-analyzer
  "rust-analyzer.server.path": "rust-analyzer",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // golang.go
  "go.alternateTools": {
    "gopls": "gopls"
  },
  "gopls": { "ui.semanticTokens": true },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },

  // jetbrains.kotlin-server
  "[kotlin]": {
    "editor.defaultFormatter": "jetbrains.kotlin-server"
  },

  // ms-pyright.pyright
  "pyright.disableLanguageServices": false,

  // charliermarsh.ruff
  "ruff.enable": true,
  "ruff.nativeServer": "on",
  "ruff.path": ["ruff"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },

  // gleam.gleam
  "gleam.prerelease": false,
  "[gleam]": {
    "editor.defaultFormatter": "gleam.gleam"
  },

  // erlang-language-platform.erlang-language-platform
  // Formats with its bundled erlfmt: elpClient.erlfmt.path is machine-scoped, so a workspace cannot
  // point it at the dev shell's erlfmt that `nix fmt` runs.
  "elpClient.serverPath": "elp",
  "[erlang]": {
    "editor.defaultFormatter": "erlang-language-platform.erlang-language-platform"
  },

  // TypeScriptTeam.native-preview
  "js/ts.experimental.useTsgo": true,

  // esbenp.prettier-vscode
  "prettier.enable": false,

  // oxc.oxc-vscode
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always" // oxlint
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // redhat.vscode-yaml
  "yaml.format.enable": false,

  // bufbuild.vscode-buf
  "[proto]": {
    "editor.defaultFormatter": "bufbuild.vscode-buf"
  },

  // jnoortheen.nix-ide
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "(builtins.getFlake (builtins.toString ./.)).outputs.nixpkgs.${builtins.currentSystem}"
      },
      "formatting": {
        "command": ["nixfmt"]
      }
    }
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  }
}
