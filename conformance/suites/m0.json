{
  "schema_version": 1,
  "suite_id": "m0",
  "protocol_version": 1,
  "peer_resolution": "path_or_override",
  "allowance_policy": "peer_specific",
  "startup_timeout_ms": 5000,
  "case_timeout_ms": 2000,
  "shutdown_timeout_ms": 1000,
  "max_command_bytes": 262144,
  "max_event_bytes": 65536,
  "max_stdout_bytes": 1048576,
  "max_stderr_bytes": 1048576,
  "crash_budget": 3,
  "golden_path": "../../testdata/wire-golden-vectors.txt",
  "corpus_paths": [
    "../corpus/v1/valid-wire.json",
    "../corpus/v1/malformed-wire.json",
    "../corpus/v1/framing.json",
    "../corpus/v1/stream-state.json"
  ],
  "peers": [
    {
      "id": "go",
      "command": ["trevrpc-conformance-go", "--protocol", "1"],
      "required_capabilities": [
        "codec.decode",
        "codec.encode",
        "framing.decode_stream",
        "framing.encode",
        "state.client_stream",
        "state.server_stream"
      ]
    }
  ]
}
