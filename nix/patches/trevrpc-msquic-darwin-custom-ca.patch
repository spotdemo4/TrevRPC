+static
+CFMutableArrayRef
+CxPlatCertCreateTrustAnchors(
+    _In_ X509_STORE* TrustStore
+    )
+{
+    const STACK_OF(X509_OBJECT)* Objects = X509_STORE_get0_objects(TrustStore);
+    if (Objects == NULL) {
+        return NULL;
+    }
+
+    CFMutableArrayRef Anchors =
+        CFArrayCreateMutable(
+            NULL,
+            sk_X509_OBJECT_num(Objects),
+            &kCFTypeArrayCallBacks);
+    if (Anchors == NULL) {
+        return NULL;
+    }
+
+    for (int Index = 0; Index < sk_X509_OBJECT_num(Objects); ++Index) {
+        X509_OBJECT* Object = sk_X509_OBJECT_value(Objects, Index);
+        if (X509_OBJECT_get_type(Object) != X509_LU_X509) {
+            continue;
+        }
+
+        X509* X509Cert = X509_OBJECT_get0_X509(Object);
+        int CertLength = i2d_X509(X509Cert, NULL);
+        if (CertLength <= 0) {
+            CFRelease(Anchors);
+            return NULL;
+        }
+
+        unsigned char* CertBuffer = OPENSSL_malloc((size_t)CertLength);
+        if (CertBuffer == NULL) {
+            CFRelease(Anchors);
+            return NULL;
+        }
+        unsigned char* Cursor = CertBuffer;
+        if (i2d_X509(X509Cert, &Cursor) != CertLength) {
+            OPENSSL_free(CertBuffer);
+            CFRelease(Anchors);
+            return NULL;
+        }
+
+        CFDataRef CertData =
+            CFDataCreate(
+                NULL,
+                CertBuffer,
+                CertLength);
+        OPENSSL_free(CertBuffer);
+        if (CertData == NULL) {
+            CFRelease(Anchors);
+            return NULL;
+        }
+
+        SecCertificateRef Certificate =
+            SecCertificateCreateWithData(NULL, CertData);
+        CFRelease(CertData);
+        if (Certificate == NULL) {
+            CFRelease(Anchors);
+            return NULL;
+        }
+        CFArrayAppendValue(Anchors, Certificate);
+        CFRelease(Certificate);
+    }
+
+    if (CFArrayGetCount(Anchors) == 0) {
+        CFRelease(Anchors);
+        return NULL;
+    }
+    return Anchors;
+}
+
 _Success_(return != FALSE)
 BOOLEAN
