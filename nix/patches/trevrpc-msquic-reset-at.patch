+BOOLEAN
+QuicStreamCanSendResetFrame(
+    _In_ const QUIC_STREAM* Stream
+    )
+{
+    if (!Stream->Flags.ReliableResetSendFinalSizeSet ||
+        Stream->Flags.ReliableResetSendFinalSizeReserved) {
+        return TRUE;
+    }
+
+    CXPLAT_DBG_ASSERT(
+        Stream->ReliableResetSendFinalSize >= Stream->MaxSentLength);
+    if (Stream->ReliableResetSendFinalSize > Stream->MaxAllowedSendOffset) {
+        return FALSE;
+    }
+
+    const QUIC_SEND* Send = &Stream->Connection->Send;
+    CXPLAT_DBG_ASSERT(Send->OrderedStreamBytesSent <= Send->PeerMaxData);
+    const uint64_t FlowControlIncrease =
+        Stream->ReliableResetSendFinalSize - Stream->MaxSentLength;
+    return
+        FlowControlIncrease <= Send->PeerMaxData - Send->OrderedStreamBytesSent;
+}
