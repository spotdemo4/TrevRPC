+void
+QuicStreamReserveResetFrameFlowControl(
+    _In_ QUIC_STREAM* Stream
+    )
+{
+    if (!Stream->Flags.ReliableResetSendFinalSizeSet ||
+        Stream->Flags.ReliableResetSendFinalSizeReserved) {
+        return;
+    }
+
+    QUIC_SEND* Send = &Stream->Connection->Send;
+    CXPLAT_DBG_ASSERT(QuicStreamCanSendResetFrame(Stream));
+    const uint64_t FlowControlIncrease =
+        Stream->ReliableResetSendFinalSize - Stream->MaxSentLength;
+    Send->OrderedStreamBytesSent += FlowControlIncrease;
+    Stream->MaxSentLength = Stream->ReliableResetSendFinalSize;
+    Stream->Flags.ReliableResetSendFinalSizeReserved = TRUE;
+}
