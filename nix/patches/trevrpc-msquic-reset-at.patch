+void
+QuicConnProcessResetStreamAtNegotiation(
+    _Inout_ QUIC_CONNECTION* Connection,
+    _In_ BOOLEAN FromResumptionTicket
+    )
+{
+    uint32_t PeerDialectMask = 0;
+    if (Connection->PeerTransportParams.Flags &
+        QUIC_TP_FLAG_RESET_STREAM_AT_DRAFT_07) {
+        PeerDialectMask |= QUIC_RESET_STREAM_AT_DIALECT_DRAFT_07;
+    }
+    if (Connection->PeerTransportParams.Flags &
+        QUIC_TP_FLAG_RESET_STREAM_AT_DRAFT_10) {
+        PeerDialectMask |= QUIC_RESET_STREAM_AT_DIALECT_DRAFT_10;
+    }
+
+    Connection->ResetStreamAtPeerDialectMask = PeerDialectMask;
+    if (FromResumptionTicket) {
+        //
+        // A remembered peer receive capability authorizes 0-RTT sending. The
+        // public negotiation result and event remain tied to the live handshake,
+        // which will overwrite this mask when its transport parameters arrive.
+        //
+        return;
+    }
+
+    Connection->ResetStreamAtNegotiatedDialectMask =
+        Connection->ResetStreamAtRequestedDialectMask & PeerDialectMask;
+
+    if (Connection->ResetStreamAtRequestedDialectMask != 0 &&
+        !Connection->State.ResetStreamAtNegotiationEventEmitted) {
+        QUIC_CONNECTION_EVENT Event = {0};
+        Event.Type = QUIC_CONNECTION_EVENT_RELIABLE_RESET_NEGOTIATED;
+        Event.RELIABLE_RESET_NEGOTIATED.RequestedDialectMask =
