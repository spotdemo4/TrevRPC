+TEST(StreamResetTest, ReceiverDoesNotDoubleCreditPendingAppReceive)
+{
+    QUIC_CONNECTION Connection = {};
+    QUIC_STREAM Stream = {};
+    Stream.Connection = &Connection;
+    Stream.RecvMaxLength = UINT64_MAX;
+    Stream.ReliableOffsetRecv = UINT64_MAX;
+    Stream.MaxAllowedRecvOffset = 80;
+    Connection.ResetStreamAtRequestedDialectMask =
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_07;
+    Connection.Send.MaxData = 100;
+    Connection.Send.OrderedStreamBytesReceived = 20;
+    Connection.Send.Uninitialized = TRUE;
+
+    ASSERT_EQ(
+        QUIC_STATUS_SUCCESS,
+        QuicRecvBufferInitialize(
+            &Stream.RecvBuffer,
+            128,
+            128,
+            QUIC_RECV_BUF_MODE_SINGLE,
+            nullptr));
+
+    uint8_t Data[20] = {};
+    uint64_t QuotaConsumed = 0;
+    uint64_t BufferSizeNeeded = 0;
+    BOOLEAN NewDataReady = FALSE;
+    ASSERT_EQ(
+        QUIC_STATUS_SUCCESS,
+        QuicRecvBufferWrite(
+            &Stream.RecvBuffer,
+            0,
+            sizeof(Data),
+            Data,
+            100,
+            &QuotaConsumed,
+            &NewDataReady,
+            &BufferSizeNeeded));
+    ASSERT_EQ(sizeof(Data), QuotaConsumed);
+
+    QUIC_BUFFER Buffer = {};
+    uint32_t BufferCount = 1;
+    uint64_t BufferOffset = 0;
+    QuicRecvBufferRead(
+        &Stream.RecvBuffer,
+        &BufferOffset,
+        &BufferCount,
+        &Buffer);
+    ASSERT_EQ(sizeof(Data), Buffer.Length);
+    Stream.RecvPendingLength = sizeof(Data);
+
+    QuicStreamProcessReliableResetFrame(&Stream, 7, 80, 0);
+
+    EXPECT_TRUE(Stream.Flags.RemoteCloseAcked);
+    EXPECT_TRUE(Stream.Flags.RecvFinalSizeCreditReturned);
+    EXPECT_EQ(20ull, Stream.RecvPendingLength);
+    EXPECT_EQ(80ull, Connection.Send.OrderedStreamBytesReceived);
+    EXPECT_EQ(160ull, Connection.Send.MaxData);
+
+    QuicRecvBufferResetRead(&Stream.RecvBuffer);
+    QuicRecvBufferUninitialize(&Stream.RecvBuffer);
+}
