+/*++
+
+    Copyright (c) Microsoft Corporation.
+    Licensed under the MIT License.
+
+Abstract:
+
+    Focused semantic tests for RESET_STREAM_AT sender and receiver state.
+
+--*/
+
+#include "main.h"
+
+TEST(StreamResetTest, ConnectionAliasDerivesRequestedDialectMask)
+{
+    QUIC_CONNECTION Connection = {};
+    QUIC_CONFIGURATION Configuration = {};
+
+    Connection.Settings.ReliableResetEnabled = TRUE;
+    EXPECT_EQ(
+        QUIC_RESET_STREAM_AT_SUPPORTED_DIALECT_MASK,
+        QuicConnGetResetStreamAtRequestedDialectMask(
+            &Connection,
+            &Configuration));
+
+    Connection.Settings.ReliableResetEnabled = FALSE;
+    EXPECT_EQ(
+        0u,
+        QuicConnGetResetStreamAtRequestedDialectMask(
+            &Connection,
+            &Configuration));
+
+    Configuration.ResetStreamAtDialectMaskExplicit = TRUE;
+    Configuration.ResetStreamAtDialectMask = 0;
+    Connection.Settings.ReliableResetEnabled = TRUE;
+    EXPECT_EQ(
+        0u,
+        QuicConnGetResetStreamAtRequestedDialectMask(
+            &Connection,
+            &Configuration));
+
+    Configuration.ResetStreamAtDialectMask =
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_07;
+    Connection.Settings.ReliableResetEnabled = FALSE;
+    EXPECT_EQ(
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_07,
+        QuicConnGetResetStreamAtRequestedDialectMask(
+            &Connection,
+            &Configuration));
+}
+
+TEST(StreamResetTest, ResumptionRestoresPeerSendPermissionOnly)
+{
+    QUIC_CONNECTION Connection = {};
+    Connection.ResetStreamAtRequestedDialectMask =
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_07;
+    Connection.PeerTransportParams.Flags =
+        QUIC_TP_FLAG_RESET_STREAM_AT_DRAFT_07 |
+        QUIC_TP_FLAG_RESET_STREAM_AT_DRAFT_10;
+
+    QuicConnProcessResetStreamAtNegotiation(&Connection, TRUE);
+
+    EXPECT_EQ(
+        QUIC_RESET_STREAM_AT_SUPPORTED_DIALECT_MASK,
+        Connection.ResetStreamAtPeerDialectMask);
+    EXPECT_EQ(0u, Connection.ResetStreamAtNegotiatedDialectMask);
+    EXPECT_FALSE(Connection.State.ResetStreamAtNegotiationEventEmitted);
+    EXPECT_TRUE(QuicConnCanSendResetStreamAt(&Connection));
+    EXPECT_TRUE(QuicConnCanReceiveResetStreamAt(&Connection));
+}
+
+TEST(StreamResetTest, ResumptionRejectsRemovedReceiveCapability)
+{
+    QUIC_CONNECTION Connection = {};
+    QUIC_TRANSPORT_PARAMETERS ResumedTP = {};
+
+    ResumedTP.Flags = QUIC_TP_FLAG_RESET_STREAM_AT_DRAFT_07;
+    Connection.ResetStreamAtRequestedDialectMask = 0;
+    EXPECT_FALSE(
+        QuicConnIsResetStreamAtResumptionCompatible(
+            &Connection,
+            &ResumedTP));
+
+    Connection.ResetStreamAtRequestedDialectMask =
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_10;
+    EXPECT_TRUE(
+        QuicConnIsResetStreamAtResumptionCompatible(
+            &Connection,
+            &ResumedTP));
+
+    ResumedTP.Flags = 0;
+    Connection.ResetStreamAtRequestedDialectMask = 0;
+    EXPECT_TRUE(
+        QuicConnIsResetStreamAtResumptionCompatible(
+            &Connection,
+            &ResumedTP));
+}
+
+TEST(StreamResetTest, DirectionalAdvertisementsGateFrameUse)
+{
+    QUIC_CONNECTION Connection = {};
+    QUIC_STREAM Stream = {};
+    Stream.Connection = &Connection;
+    Stream.QueuedSendOffset = 10;
+    Stream.RecvMaxLength = UINT64_MAX;
+    Stream.ReliableOffsetRecv = UINT64_MAX;
+    Stream.MaxAllowedRecvOffset = 10;
+    Connection.Send.MaxData = 10;
+
+    Connection.ResetStreamAtRequestedDialectMask =
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_07;
+    Connection.ResetStreamAtPeerDialectMask =
+        QUIC_RESET_STREAM_AT_DIALECT_DRAFT_10;
+    Connection.ResetStreamAtNegotiatedDialectMask = 0;
+
