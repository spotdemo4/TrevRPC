@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(trevrpc 0.1 CONFIG)
if(NOT TREVRPC_C_ABI_VERSION EQUAL 6)
    set(trevrpc-cpp_FOUND FALSE)
    set(trevrpc-cpp_NOT_FOUND_MESSAGE "trevrpc-cpp requires TrevRPC C ABI 6")
    return()
endif()
find_dependency(Protobuf CONFIG)
find_dependency(Threads REQUIRED)

set(TREVRPC_CPP_BINDIR "@PACKAGE_CMAKE_INSTALL_BINDIR@")

include("${CMAKE_CURRENT_LIST_DIR}/trevrpcCppTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/trevrpc-cpp-generate.cmake")

check_required_components(trevrpc-cpp)
