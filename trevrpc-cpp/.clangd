CompileFlags:
  # Primary source of truth is compile_commands.json generated by CMake.
  # `CMAKE_EXPORT_COMPILE_COMMANDS` is ON by default in CMakeLists.txt, so
  # a configure like `cmake -S trevrpc-cpp -B trevrpc-cpp/build` produces
  # `trevrpc-cpp/build/compile_commands.json` which clangd will use.
  CompilationDatabase: build
  Add:
    - -xc++
    - -std=c++20
    - -DPROTOBUF_USE_DLLS
    # Fallback when compile_commands.json is missing. Clangd resolves these
    # relative to the source file's directory, so we use `../` / `../../`
    # accordingly. Keep in sync with compile_commands entries.
    - -I
    - ../include
    - -I
    - ../../trevrpc-c/include
    - -I
    - ../build/bench/generated
    - -I
    - ../../build/trevrpc-cpp/bench/generated
    - -I
    - ../../build/trevrpc-cpp-m3/bench/generated
    - -I
    - .
