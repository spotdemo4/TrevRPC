{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/TrevRPC"],
  "allowedCommands": [
    "^nix run \\.#update-go-deps$",
    "^npm audit fix --prefix trevrpc-js$",
    "^nix run \\.#update-kotlin-deps$",
    "^nix run \\.#sync-playwright$"
  ],
  "allowedUnsafeExecutions": ["gradleWrapper"],
  // update-kotlin-deps refreshes every Gradle dependency and then rebuilds the
  // mitm-cache, which can exceed the 15-minute default on a cold runner.
  "executionTimeout": 45,
  // Renovate sanitizes child environments, so configure this through its
  // explicit child-process environment instead of the workflow environment.
  "customEnvVariables": {
    "JAVA_TOOL_OPTIONS": "-Dorg.gradle.dependency.verification=lenient"
  },

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "ignoreDeps": ["@trevrpc/trevrpc-js"],
  "nix": {
    "enabled": true
  },
  "gradle": {
    "ignorePaths": []
  },
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false,
    "postUpgradeTasks": {
      "commands": [
        "nix run .#update-go-deps",
        "npm audit fix --prefix trevrpc-js",
        "nix run .#sync-playwright"
      ],
      "fileFilters": [
        "trevrpc-go/go.mod",
        "trevrpc-go/go.sum",
        "trevrpc-go/default.nix",
        "trevrpc-js/package.json",
        "trevrpc-js/package-lock.json"
      ],
      "executionMode": "branch"
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"],
      "postUpgradeTasks": {
        "commands": ["nix run .#sync-playwright"],
        "fileFilters": ["trevrpc-js/package.json", "trevrpc-js/package-lock.json"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["trevrpc-go/go.mod"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-go-deps"],
        "fileFilters": ["trevrpc-go/go.mod", "trevrpc-go/go.sum", "trevrpc-go/default.nix"],
        "executionMode": "branch"
      }
    },
    {
      // quic-go and webtransport-go release as a compatible pair.
      "matchManagers": ["gomod"],
      "matchFileNames": ["trevrpc-go/go.mod"],
      "matchPackageNames": ["github.com/quic-go/quic-go", "github.com/quic-go/webtransport-go"],
      "groupName": "quic-go transport stack",
      "groupSlug": "quic-go-transport-stack",
      "separateMajorMinor": false
    },
    {
      // cronet-api 500.x is an empty redirect to the aggregate cronet artifact.
      "matchManagers": ["gradle"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["org.chromium.net:cronet-api"],
      "allowedVersions": "/^[0-9]+\\.[0-9]{4,}\\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$/"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "addLabels": ["kotlin"]
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper", "maven"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-kotlin-deps"],
        "fileFilters": [
          "trevrpc-kotlin/**/gradle.lockfile",
          "trevrpc-kotlin/settings-gradle.lockfile",
          "trevrpc-kotlin/gradle/verification-metadata.xml",
          "trevrpc-kotlin/gradle/deps.json"
        ],
        "executionMode": "branch"
      }
    },
    {
      // Nixpkgs supplies the matching browser binaries and is the version authority.
      "matchManagers": ["npm"],
      "matchPackageNames": ["playwright", "playwright-core"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["node"],
      "rangeStrategy": "bump",
      "postUpdateOptions": ["npmInstallTwice"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
