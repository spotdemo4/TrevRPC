{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/TrevRPC"],
  "allowedCommands": [
    "^fix-hash \\.#trevrpc-go$",
    "^npm audit fix --prefix trevrpc-js$",
    "^trevrpc-kotlin/gradlew --project-dir trevrpc-kotlin --no-configuration-cache --refresh-dependencies --write-locks --write-verification-metadata sha256 resolveAndLockAll$",
    "^nix run \\.#update-kotlin-deps$"
  ],
  "allowedUnsafeExecutions": ["gradleWrapper"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "ignoreDeps": ["trevrpc-bench-peer-js", "trevrpc-js"],
  "nix": {
    "enabled": true
  },
  "gradle": {
    "ignorePaths": []
  },
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false,
    "postUpgradeTasks": {
      "commands": ["fix-hash .#trevrpc-go", "npm audit fix --prefix trevrpc-js"]
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "postUpgradeTasks": {
        "commands": ["fix-hash .#trevrpc-go"]
      }
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "addLabels": ["kotlin"]
    },
    {
      "matchManagers": ["gradle"],
      "postUpgradeTasks": {
        "commands": [
          "trevrpc-kotlin/gradlew --project-dir trevrpc-kotlin --no-configuration-cache --refresh-dependencies --write-locks --write-verification-metadata sha256 resolveAndLockAll",
          "nix run .#update-kotlin-deps"
        ],
        "fileFilters": [
          "trevrpc-kotlin/**/gradle.lockfile",
          "trevrpc-kotlin/settings-gradle.lockfile",
          "trevrpc-kotlin/gradle/verification-metadata.xml",
          "trevrpc-kotlin/gradle/deps.json"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["node"],
      "rangeStrategy": "bump",
      "postUpdateOptions": ["npmInstallTwice"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
