{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/TrevRPC"],
  "allowedCommands": [
    "^nix run \\.#update-go-deps$",
    "^npm audit fix --prefix trevrpc-js$",
    "^nix run \\.#update-kotlin-deps$",
    "^nix run \\.#sync-playwright$",
    "^nix run \\.#update-benchmark-proto$"
  ],
  "allowedUnsafeExecutions": ["gradleWrapper"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "ignoreDeps": ["trevrpc-bench-peer-js", "@trevrpc/trevrpc-js"],
  "nix": {
    "enabled": true
  },
  "gradle": {
    "ignorePaths": []
  },
  "git-submodules": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false,
    "postUpgradeTasks": {
      "commands": [
        "nix run .#update-go-deps",
        "npm audit fix --prefix trevrpc-js",
        "nix run .#sync-playwright",
        "nix run .#update-benchmark-proto"
      ],
      "fileFilters": [
        "trevrpc-go/go.mod",
        "trevrpc-go/go.sum",
        "trevrpc-go/default.nix",
        "trevrpc-js/package.json",
        "trevrpc-js/package-lock.json",
        "trevrpc-js/bench-browser/package.json",
        "trevrpc-js/bench-browser/package-lock.json",
        "trevrpc-c/bench/proto/benchmark.proto",
        "trevrpc-kotlin/bench-peer/src/main/proto/benchmark.proto",
        "trevrpc-rust/crates/trevrpc-bench-peer/proto/benchmark.proto",
        "trevrpc-go/cmd/trevrpc-bench-peer/benchmarkpb/benchmark.pb.go",
        "trevrpc-go/cmd/trevrpc-bench-peer/benchmarkpb/benchmark.trevrpc.go"
      ],
      "executionMode": "branch"
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"],
      "postUpgradeTasks": {
        "commands": ["nix run .#sync-playwright", "nix run .#update-benchmark-proto"],
        "fileFilters": [
          "trevrpc-js/package.json",
          "trevrpc-js/package-lock.json",
          "trevrpc-js/bench-browser/package.json",
          "trevrpc-js/bench-browser/package-lock.json",
          "trevrpc-c/bench/proto/benchmark.proto",
          "trevrpc-kotlin/bench-peer/src/main/proto/benchmark.proto",
          "trevrpc-rust/crates/trevrpc-bench-peer/proto/benchmark.proto",
          "trevrpc-go/cmd/trevrpc-bench-peer/benchmarkpb/benchmark.pb.go",
          "trevrpc-go/cmd/trevrpc-bench-peer/benchmarkpb/benchmark.trevrpc.go"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-go-deps"],
        "fileFilters": ["trevrpc-go/go.mod", "trevrpc-go/go.sum", "trevrpc-go/default.nix"],
        "executionMode": "branch"
      }
    },
    {
      // quic-go and webtransport-go release as a compatible pair.
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/quic-go/quic-go", "github.com/quic-go/webtransport-go"],
      "groupName": "quic-go transport stack",
      "groupSlug": "quic-go-transport-stack",
      "separateMajorMinor": false
    },
    {
      // Maven publication checks inject this repository at runtime.
      "matchManagers": ["maven"],
      "matchFileNames": [
        "trevrpc-kotlin/publication-tests/maven/**/pom.xml",
        "trevrpc-kotlin/publication-tests/cronet/maven/**/pom.xml"
      ],
      "registryUrls": ["https://repo.maven.apache.org/maven2"]
    },
    {
      // These coordinates are produced into a staged repository by this build.
      "matchManagers": ["maven", "gradle"],
      "matchFileNames": [
        "trevrpc-kotlin/publication-tests/maven/**/pom.xml",
        "trevrpc-kotlin/publication-tests/cronet/maven/**/pom.xml",
        "trevrpc-kotlin/publication-tests/gradle/**/*.gradle.kts",
        "trevrpc-kotlin/publication-tests/cronet/gradle/**/*.gradle.kts"
      ],
      "matchPackageNames": [
        "zip.trev.trevrpc:core",
        "zip.trev.trevrpc:transport-netty",
        "zip.trev.trevrpc:transport-cronet",
        "zip.trev.trevrpc:protoc-gen-trevrpc-kotlin",
        "zip.trev.trevrpc.fixture:publication-consumers"
      ],
      "enabled": false
    },
    {
      // cronet-api 500.x is an empty redirect to the aggregate cronet artifact.
      "matchManagers": ["gradle"],
      "matchDatasources": ["maven"],
      "matchPackageNames": ["org.chromium.net:cronet-api"],
      "allowedVersions": "/^[0-9]+\\.[0-9]{4,}\\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$/"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "addLabels": ["kotlin"]
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-kotlin-deps"],
        "fileFilters": [
          "trevrpc-kotlin/**/gradle.lockfile",
          "trevrpc-kotlin/settings-gradle.lockfile",
          "trevrpc-kotlin/gradle/verification-metadata.xml",
          "trevrpc-kotlin/gradle/deps.json"
        ],
        "executionMode": "branch"
      }
    },
    {
      // Nixpkgs supplies the matching browser binaries and is the version authority.
      "matchManagers": ["npm"],
      "matchPackageNames": ["playwright", "playwright-core"],
      "enabled": false
    },
    {
      // The native package is built and versioned with trevrpc-js in this repository.
      "matchManagers": ["npm"],
      "matchPackageNames": ["@trevrpc/trevrpc-js-native-linux-x64-gnu"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["node"],
      "rangeStrategy": "bump",
      "postUpdateOptions": ["npmInstallTwice"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
