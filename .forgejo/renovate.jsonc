{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/TrevRPC"],
  "allowedCommands": [
    "^nix run \\.#update-go-deps$",
    "^nix run \\.#update-kotlin-deps$",
    "^nix run \\.#sync-playwright$"
  ],
  "allowedUnsafeExecutions": ["gradleWrapper"],
  // Renovate sanitizes child environments, so configure this through its
  // explicit child-process environment instead of the workflow environment.
  "customEnvVariables": {
    "JAVA_TOOL_OPTIONS": "-Dorg.gradle.dependency.verification=lenient"
  },

  // repository
  "extends": ["config:recommended"],
  // Renovate runs once a day, so the default of 2 PRs per hour caps creation
  // at 2 PRs per run. Keep the default cap of 10 open PRs to limit CI load
  // and rebase churn.
  "prHourlyLimit": 0,
  "addLabels": ["dep"],
  "ignoreDeps": ["@trevrpc/trevrpc-js"],
  "nix": {
    "enabled": true
  },
  "gradle": {
    "ignorePaths": []
  },
  "git-submodules": {
    "enabled": true
  },
  // fix PRs for vulnerable dependencies, from osv.dev: direct and indirect go
  // modules, and direct dependencies elsewhere. transitive vulnerabilities
  // are reported by the vulnerable workflow
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false,
    "postUpgradeTasks": {
      "commands": ["nix run .#update-go-deps", "nix run .#sync-playwright"],
      "fileFilters": [
        "trevrpc-go/go.mod",
        "trevrpc-go/go.sum",
        "trevrpc-go/gomod2nix.toml",
        "bench/baseline/go.mod",
        "bench/baseline/go.sum",
        "bench/baseline/gomod2nix.toml",
        "trevrpc-js/package.json",
        "trevrpc-js/package-lock.json"
      ],
      "executionMode": "branch"
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },

    // disable nix digest updates
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },

    // disable npm engine updates
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },

    // keep peer ranges as wide as a package supports; raise them by hand when it needs newer peers
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },

    // add labels
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["node"]
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper", "maven"],
      "addLabels": ["kotlin"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },

    // sync playwright from nix to npm
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["playwright", "playwright-core"],
      "enabled": false
    },
    {
      "matchManagers": ["nix"],
      "postUpgradeTasks": {
        "commands": ["nix run .#sync-playwright"],
        "fileFilters": ["trevrpc-js/package.json", "trevrpc-js/package-lock.json"],
        "executionMode": "branch"
      }
    },

    // update go deps
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodUpdateImportPaths"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-go-deps"],
        "fileFilters": ["**/go.mod", "**/go.sum", "**/gomod2nix.toml"],
        "executionMode": "branch"
      }
    },

    // update kotlin deps
    {
      "matchManagers": ["gradle", "gradle-wrapper", "maven"],
      "postUpgradeTasks": {
        "commands": ["nix run .#update-kotlin-deps"],
        "fileFilters": [
          "trevrpc-kotlin/**/gradle.lockfile",
          "trevrpc-kotlin/settings-gradle.lockfile",
          "trevrpc-kotlin/gradle/verification-metadata.xml",
          "trevrpc-kotlin/gradle/deps.json"
        ],
        "executionMode": "branch"
      }
    },

    // update npm deps
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
      "postUpdateOptions": ["npmInstallTwice"]
    },

    // group quic-go across every trevrpc-go module that requires it directly,
    // so the library and the modules built against it update together
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["trevrpc-go/**/go.mod"],
      "matchPackageNames": ["github.com/quic-go/**"],
      "groupName": "quic-go",
      "separateMajorMinor": false
    },

    // group h3, whose crates release in lockstep; match the Cargo.toml names
    // so the rule covers both the trev-h3 fork and upstream
    {
      "matchManagers": ["cargo"],
      "matchDepNames": ["h3", "h3-*"],
      "groupName": "h3",
      "separateMajorMinor": false
    },

    // group connectrpc (go & js)
    {
      "matchManagers": ["gomod", "npm"],
      "matchPackageNames": ["@connectrpc/**", "connectrpc.com/**"],
      "groupName": "connectrpc"
    }
  ]
}
