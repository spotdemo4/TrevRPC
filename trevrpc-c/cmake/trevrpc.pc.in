prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=@trevrpc_pc_libdir@
includedir=@trevrpc_pc_includedir@

Name: trevrpc
Description: High-level TrevRPC C runtime over MsQuic
Version: @PROJECT_VERSION@
Requires.private: trevrpc_core trevrpc_msquic trevrpc_webtransport
Libs: -L${libdir} -ltrevrpc
Cflags: -I${includedir}
