set(TREVRPC_TRANSPORT_MSQUIC_ABI_VERSION @TREVRPC_TRANSPORT_MSQUIC_ABI_VERSION@)
include("${CMAKE_CURRENT_LIST_DIR}/trevrpcTransportMsquicTargets.cmake")
check_required_components(trevrpc_transport_msquic)
