prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=@trevrpc_pc_libdir@
includedir=@trevrpc_pc_includedir@
trevrpc_c_abi_version=@TREVRPC_C_ABI_VERSION@

Name: trevrpc_webtransport
Description: TrevRPC C low-level WebTransport wrapper
Version: @PROJECT_VERSION@
Requires.private: trevrpc_msquic trevrpc_core
Libs: -L${libdir} -ltrevrpc_webtransport
Cflags: -I${includedir}
