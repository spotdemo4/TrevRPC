prefix=@trevrpc_pc_prefix@
exec_prefix=${prefix}
libdir=@trevrpc_pc_libdir@
includedir=@trevrpc_pc_includedir@
trevrpc_rpc_msquic_abi_version=@TREVRPC_RPC_MSQUIC_ABI_VERSION@

Name: trevrpc_rpc_msquic
Description: TrevRPC MsQuic RPC runtime companion
Version: @PROJECT_VERSION@
Requires: trevrpc_rpc = @PROJECT_VERSION@ trevrpc_transport_msquic = @PROJECT_VERSION@
Libs: -L${libdir} -ltrevrpc_rpc_msquic
Cflags: -I${includedir}
