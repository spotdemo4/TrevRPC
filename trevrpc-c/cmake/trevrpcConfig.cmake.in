@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
@TREVRPC_ENGINE_FIND_DEPENDENCY@
if(@TREVRPC_BUILD_MSQUIC@ OR @TREVRPC_BUILD_ENGINE_MSQUIC@)
    find_dependency(msquic CONFIG)
endif()

set(TREVRPC_C_ABI_VERSION @TREVRPC_C_ABI_VERSION@)
set(TREVRPC_ENGINE_AVAILABLE @TREVRPC_BUILD_ENGINE@)
if(TREVRPC_ENGINE_AVAILABLE)
    set(TREVRPC_ENGINE_ABI_VERSION @TREVRPC_ENGINE_ABI_VERSION@)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/trevrpcTargets.cmake")

check_required_components(trevrpc)
