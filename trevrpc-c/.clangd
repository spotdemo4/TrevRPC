CompileFlags:
  # Primary source of truth is compile_commands.json generated by CMake.
  # `CMAKE_EXPORT_COMPILE_COMMANDS` is ON by default in CMakeLists.txt, so
  # a configure like `cmake -S trevrpc-c -B trevrpc-c/build` produces
  # `trevrpc-c/build/compile_commands.json` which clangd will use.
  CompilationDatabase: build
  Add:
    - -xc
    - -std=c11
    - -DQUIC_API_ENABLE_PREVIEW_FEATURES
    # Fallback when compile_commands.json is missing. Use repo-root
    # absolute-adjacent paths that work regardless of source-file depth.
    # Clangd resolves these relative to the source file's directory, so we
    # use `../` / `../../` accordingly. Keep in sync with compile_flags.txt.
    - -I
    - ../include
    - -I
    - ../src
    - -I
    - ../../build/generated-service-test
    - -I
    - ../../build/generated-greeter-example
    - -I
    - ../build/generated-service-test
    - -I
    - ../build/generated-greeter-example
    - -I
    - ../../build/trevrpc-c-m3/generated-service-test
    - -I
    - ../../build/trevrpc-c-m3/generated-greeter-example
    - -I
    - ../../build/trevrpc-c-m3-sanitized/generated-service-test
    - -I
    - ../../build/trevrpc-c-m3-sanitized/generated-greeter-example
    - -I
    - ../../build/c-family-m3/generated-service-test
    - -I
    - ../../build/c-family-m3/generated-greeter-example
