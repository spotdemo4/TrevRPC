{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

%% protoc-gen-trevrpc-erlang comes from _checkouts, a link to it, and gpb,
%% which it uses too, from Hex; the escript carries them both.
{deps, [{gpb, "~> 5.0.0"}, protoc_gen_trevrpc_erlang]}.

{escript_name, "protoc-gen-trevrpc-gleam"}.
{escript_main_app, protoc_gen_trevrpc_gleam}.
{escript_incl_apps, [protoc_gen_trevrpc_erlang, gpb]}.

%% test/gleam is a Gleam project, whose generated and built Erlang is its
%% own: rebar3 would otherwise look for tests in it.
{eunit_tests, [{module, protoc_gen_trevrpc_gleam_tests}]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        missing_return,
        unmatched_returns
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]},
        %% The helpers protoc-gen-trevrpc-erlang's tests share with these.
        {extra_src_dirs, [
            {"test", [{recursive, false}]},
            "_checkouts/protoc_gen_trevrpc_erlang/test/support"
        ]}
    ]}
]}.
