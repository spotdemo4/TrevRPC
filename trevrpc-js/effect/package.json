{
  "name": "@trevrpc/effect",
  "version": "1.6.0",
  "description": "Effect adapter for TrevRPC browser clients",
  "homepage": "https://trev.zip/llc/TrevRPC",
  "bugs": {
    "url": "https://trev.zip/llc/TrevRPC/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://trev.zip/llc/TrevRPC.git",
    "directory": "trevrpc-js/effect"
  },
  "files": [
    "src/**",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node test/generate.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@trevrpc/trevrpc-js": "file:..",
    "effect": "^4.1.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@trevrpc/trevrpc-js": "^1.6.0",
    "effect": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.2"
}
