{
  "name": "@trevrpc/trevrpc-js",
  "version": "0.2.3",
  "description": "Browser WebTransport client and protobuf.js code generator for TrevRPC",
  "homepage": "https://trev.zip/llc/TrevRPC",
  "bugs": {
    "url": "https://trev.zip/llc/TrevRPC/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://trev.zip/llc/TrevRPC.git"
  },
  "bin": {
    "protoc-gen-trevrpc-js": "bin/protoc-gen-trevrpc-js.js"
  },
  "files": [
    "src/**",
    "bin/protoc-gen-trevrpc-js.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node interop-browser/build.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "interop": "node interop-browser/cli.js",
    "prepack": "node -e 'if (process.env.TREVRPC_NIX_RELEASE !== \"1\") throw new Error(\"Build release tarballs with nix build .#trevrpc-js^npm\")'"
  },
  "dependencies": {
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.61.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@12.2.0"
}
