{
  "name": "trevrpc-js",
  "version": "0.1.0",
  "description": "JavaScript WebTransport runtime and protobuf.js code generator for TrevRPC",
  "license": "MIT",
  "bin": {
    "protoc-gen-trevrpc-js": "./bin/protoc-gen-trevrpc-js.js"
  },
  "files": [
    "bench",
    "bin",
    "examples",
    "native",
    "build/native/*.node",
    "src"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "node": "./src/index.node.js",
      "browser": "./src/index.js",
      "import": "./src/index.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "import": "./src/node.js"
    }
  },
  "scripts": {
    "bench:native": "node bench/rpc_comparison_native.js",
    "profile:native": "node bench/rpc_profile_native.js",
    "build:native": "cmake -S native -B build/native ${TREVRPC_C_ROOT:+-DTREVRPC_C_ROOT=$TREVRPC_C_ROOT} ${NODE_INCLUDE_DIR:+-DNODE_INCLUDE_DIR=$NODE_INCLUDE_DIR} && cmake --build build/native",
    "check": "npm run lint && npm run typecheck && npm test",
    "example:greeter": "node examples/greeter/static-server.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "protobufjs": "^8.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
