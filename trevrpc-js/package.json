{
  "name": "trevrpc-js",
  "version": "0.1.0",
  "description": "JavaScript WebTransport runtime and protobuf.js code generator for TrevRPC",
  "license": "MIT",
  "bin": {
    "protoc-gen-trevrpc-js": "./bin/protoc-gen-trevrpc-js.js"
  },
  "files": [
    "bin",
    "examples",
    "src"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "check": "npm run lint && npm test",
    "example:greeter": "node examples/greeter/static-server.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "node --test"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
