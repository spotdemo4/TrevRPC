{
  "name": "@trevrpc/trevrpc-js",
  "version": "1.1.0",
  "description": "Browser WebTransport client and protobuf.js code generator for TrevRPC",
  "homepage": "https://trev.zip/llc/TrevRPC",
  "bugs": {
    "url": "https://trev.zip/llc/TrevRPC/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://trev.zip/llc/TrevRPC.git"
  },
  "bin": {
    "protoc-gen-trevrpc-js": "bin/protoc-gen-trevrpc-js.js"
  },
  "files": [
    "src/**",
    "bin/protoc-gen-trevrpc-js.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./zstd": {
      "types": "./src/zstd.d.ts",
      "import": "./src/zstd.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node zstd-wasm/embed.js && node interop-browser/build.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "interop": "node interop-browser/cli.js"
  },
  "dependencies": {
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.1"
}
