{
  "name": "@trevrpc/trevrpc-js",
  "version": "1.10.0",
  "description": "Browser WebTransport client for TrevRPC, on protobuf-es",
  "homepage": "https://trev.zip/llc/TrevRPC",
  "bugs": {
    "url": "https://trev.zip/llc/TrevRPC/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://trev.zip/llc/TrevRPC.git"
  },
  "files": [
    "src/**",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./zstd": {
      "types": "./src/zstd.d.ts",
      "import": "./src/zstd.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node zstd-wasm/embed.js && node interop-browser/build.js && node test/generate.js",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "interop": "node interop-browser/cli.js"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "playwright": "1.64.1",
    "rolldown": "^1.3.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.17.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.2"
}
