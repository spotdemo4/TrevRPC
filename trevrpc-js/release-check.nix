# The npm tarballs as the release packs them.
#
# flake-release does not publish what Nix builds. For each package it builds `.#<package>.src`,
# copies that source tree to a writable directory, enters the package's `sourceRoot` and runs
# `npm publish` there. A tarball therefore holds only what the source tree holds: the build output,
# where `npm run build` has already written the generated files, is never looked at, and the
# `.npmrc` of the package (ignore-scripts) rules out generating them with an npm lifecycle script.
# The installCheckPhase of trevrpc-js packs the build output, so it cannot see a file that only the
# build produces: 1.6.0 to 1.8.0 were published without src/zstd-wasm.js.
#
# This check packs the same trees the same way and loads the tarballs as a consumer would. It uses
# `npm pack`, which applies the `files` list as `npm publish` does; the sandbox has no network for
# the `npm ci` that only installs dependencies, or for the registry round trip of
# `npm publish --dry-run`.
{
  lib,
  runCommand,
  nodejs_26,
  trevrpc-js,
  trevrpc-js-effect,
  trevrpc-js-protovalidate,
  trevrpc-js-protoc-gen,
}:
let
  packages = [
    trevrpc-js
    trevrpc-js-effect
    trevrpc-js-protovalidate
    trevrpc-js-protoc-gen
  ];
  # The directory flake-release enters: the package's sourceRoot within its source.
  directory = package: lib.removePrefix "${package.src.name}/" package.sourceRoot;
in
runCommand "trevrpc-js-release-check"
  {
    nativeBuildInputs = [ nodejs_26 ];
    # The peer dependency, which the built trevrpc-js carries.
    peerModules = "${trevrpc-js}/lib/node_modules/@trevrpc/trevrpc-js/node_modules";
  }
  ''
    export HOME="$TMPDIR/home"
    mkdir -p "$HOME" "$out"

    # Copies a package's source tree like flake-release does, enters its package directory and
    # packs it as npm would publish it, printing the tarball's name.
    pack() {
      local source="$1" directory="$2" staged="$3"
      cp -R "$source" "$staged"
      chmod -R u+w "$staged"
      mkdir -p "$TMPDIR/tarballs"
      (cd "$staged/$directory" && npm pack --silent --pack-destination "$TMPDIR/tarballs")
    }

    # Every relative import of the packed JavaScript and declarations must resolve inside the
    # tarball, since a consuming bundler resolves them there and nowhere else.
    cat > "$TMPDIR/closure.mjs" <<'EOF'
    import { existsSync, readFileSync, readdirSync } from "node:fs";
    import { dirname, join, resolve } from "node:path";
    const root = process.argv[2];
    const specifier = /\b(?:from|import)\s*\(?\s*["'](\.{1,2}\/[^"']+)["']/g;
    const missing = [];
    const walk = (directory) => {
      for (const entry of readdirSync(directory, { withFileTypes: true })) {
        const path = join(directory, entry.name);
        if (entry.isDirectory()) {
          walk(path);
        } else if (/\.(?:js|d\.ts)$/.test(entry.name)) {
          for (const [, target] of readFileSync(path, "utf8").matchAll(specifier)) {
            const file = resolve(dirname(path), target);
            // A declaration may name its sibling with the extension of the code it describes.
            if (!existsSync(file) && !existsSync(file.replace(/\.js$/, ".d.ts"))) {
              missing.push(path.slice(root.length + 1) + " imports " + target);
            }
          }
        }
      }
    };
    walk(join(root, "package"));
    if (missing.length > 0) {
      console.error("the tarball lacks files that it imports:\n" + missing.join("\n"));
      process.exit(1);
    }
    EOF

    ${lib.concatMapStringsSep "\n" (package: ''
      tarball="$(pack ${package.src} ${directory package} "$TMPDIR/staged-${package.pname}")"
      mkdir "$TMPDIR/unpacked-${package.pname}"
      tar -xzf "$TMPDIR/tarballs/$tarball" -C "$TMPDIR/unpacked-${package.pname}"
      tar -tzf "$TMPDIR/tarballs/$tarball" | sort > "$out/${package.pname}.list"
      node "$TMPDIR/closure.mjs" "$TMPDIR/unpacked-${package.pname}"
    '') packages}

    # The generated module reaches the tarball with the libzstd module in it, not as an empty file.
    wasm="$TMPDIR/unpacked-trevrpc-js/package/src/zstd-wasm.js"
    grep -qx 'package/src/zstd-wasm.js' "$out/trevrpc-js.list"
    head -c 80 "$wasm" | grep -q '^// Generated by zstd-wasm/embed.js'
    test "$(wc -c < "$wasm")" -gt 100000

    # The plugin ships its executable and the generator it runs.
    grep -qx 'package/bin/protoc-gen-trevrpc-js' "$out/trevrpc-js-protoc-gen.list"
    grep -qx 'package/src/plugin.js' "$out/trevrpc-js-protoc-gen.list"
    head -n 1 "$TMPDIR/unpacked-trevrpc-js-protoc-gen/package/bin/protoc-gen-trevrpc-js" \
      | grep -qx '#!/usr/bin/env node'

    # The adapters generate nothing, and carry nothing of trevrpc-js.
    for adapter in trevrpc-js-effect trevrpc-js-protovalidate; do
      grep -qx 'package/src/index.js' "$out/$adapter.list"
      ! grep -q 'zstd' "$out/$adapter.list"
    done

    # A consumer installing the tarball loads both entry points, the zstd one with its module.
    consumer="$TMPDIR/consumer"
    mkdir -p "$consumer/node_modules/@trevrpc"
    cp -R "$TMPDIR/unpacked-trevrpc-js/package" "$consumer/node_modules/@trevrpc/trevrpc-js"
    ln -s "$peerModules/@bufbuild" "$consumer/node_modules/@bufbuild"
    (
      cd "$consumer"
      node --input-type=module -e '
        import assert from "node:assert/strict";
        await import("@trevrpc/trevrpc-js");
        // The runtime that generated codecs import.
        const codec = await import("@trevrpc/trevrpc-js/codec");
        assert.equal(typeof codec.defineCodec, "function");
        assert.equal(typeof codec.Reader, "function");
        const zstd = await import("@trevrpc/trevrpc-js/zstd");
        assert.deepEqual(Object.keys(zstd), ["createCompression"]);
        assert.deepEqual((await zstd.createCompression()).query, [{}]);
      '
    )
  ''
