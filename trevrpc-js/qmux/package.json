{
  "name": "@trevrpc/qmux",
  "version": "1.12.0",
  "description": "QMux over WebSocket, shaped like WebTransport: QUIC streams, flow control and datagrams where UDP is blocked",
  "keywords": [
    "polyfill",
    "qmux",
    "quic",
    "streams",
    "websocket",
    "webtransport"
  ],
  "homepage": "https://trev.zip/llc/TrevRPC",
  "bugs": {
    "url": "https://trev.zip/llc/TrevRPC/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://trev.zip/llc/TrevRPC.git",
    "directory": "trevrpc-js/qmux"
  },
  "files": [
    "src/**",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=60000 test/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.3"
}
