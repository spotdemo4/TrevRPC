# TrevRPC - Git attributes
# https://git-scm.com/docs/gitattributes

# Linguist: lock files are generated
flake.lock linguist-generated=true
Cargo.lock linguist-generated=true
go.sum linguist-generated=true
gomod2nix.toml linguist-generated=true
package-lock.json linguist-generated=true
gradle.lockfile linguist-generated=true
settings-gradle.lockfile linguist-generated=true
deps.json linguist-generated=true
verification-metadata.xml linguist-generated=true

# Linguist: generated protobuf code
*.pb.go linguist-generated=true

# Rust source files use Rust diff driver
*.rs text diff=rust linguist-language=Rust

# Go source files use Go diff driver
*.go diff=go linguist-language=Go
go.mod text linguist-language=Go

# Kotlin source files
*.kt text linguist-language=Kotlin diff=kotlin
*.kts text linguist-language=Kotlin diff=kotlin

# JavaScript / TypeScript source files
*.js text diff=javascript linguist-language=JavaScript
*.mjs text diff=javascript
*.cjs text diff=javascript
*.ts text diff=typescript linguist-language=TypeScript

# Python source files use Python diff driver
*.py text diff=python

# Normalize line endings to LF and auto-detect text files
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files require CRLF (gradlew.bat is generated by Gradle)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Do not normalize patch/diff files
*.diff -text
*.patch -text

# Gradle wrapper jar is binary and vendored
gradle-wrapper.jar binary linguist-vendored=true
