# Normalize line endings to LF and auto-detect text files.
* text=auto eol=lf

# Shell scripts must retain LF (break on CRLF).
*.sh text eol=lf
*.bash text eol=lf

# Explicit text attrs for common sources (ensures LF even if auto misdetects).
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.go text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.js text eol=lf
*.json text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.md text eol=lf
*.nix text eol=lf
*.proto text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files - no EOL conversion, no textual diff.
*.a binary
*.bin binary
*.bmp binary
*.bz2 binary
*.class binary
*.dll binary
*.dylib binary
*.eot binary
*.exe binary
*.gif binary
*.gz binary
*.ico binary
*.jar binary linguist-vendored=true
*.jpeg binary
*.jpg binary
*.o binary
*.otf binary
*.pdf binary
*.png binary
*.so binary
*.tar binary
*.ttf binary
*.wasm binary
*.webp binary
*.woff binary
*.woff2 binary
*.xz binary
*.zip binary

# GitHub linguist - hide vendored/lock/generated files from language stats and collapse diffs.
flake.lock linguist-generated=true
Cargo.lock linguist-generated=true
go.sum linguist-generated=true
package-lock.json linguist-generated=true
*.lockfile linguist-generated=true

# Generated protobuf / codegen - matches treefmt excludes; keeps PR diffs readable.
*.pb.go linguist-generated=true
trevrpc-js/src/node-generated.* linguist-generated=true
trevrpc-kotlin/examples/generated/** linguist-generated=true linguist-vendored=true
trevrpc-c/tests/golden/** linguist-generated=true
