{application, qmux, [
    {description, "QMux: QUIC streams and datagrams over TLS or WebSocket"},
    {vsn, "1.13.0"},
    {registered, []},
    %% ssl only for qmux_ssl.
    {applications, [kernel, stdlib, ssl]},
    {optional_applications, [ssl]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"Source", "https://trev.zip/llc/TrevRPC/src/branch/main/trevrpc-erlang/qmux"}]}
]}.
