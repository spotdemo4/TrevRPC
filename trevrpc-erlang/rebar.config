{minimum_otp_vsn, "29"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_untyped_record
]}.

%% gleam.toml's ranges and manifest.toml's locks, which sync-erlang-deps
%% (erlang_deps.py) copies here and into rebar.lock.
{deps, [
    {quic, ">= 3.3.0 and < 3.4.0"},
    {h2, ">= 0.18.0 and < 0.19.0"},
    %% The hex packages of erlang_h1 and erlang_ws; their applications are h1
    %% and ws.
    {h1, ">= 0.11.0 and < 0.14.0", {pkg, erlang_h1}},
    {ws, ">= 0.5.0 and < 0.6.0", {pkg, erlang_ws}},
    {webtransport, ">= 0.5.13 and < 0.6.0"}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        missing_return,
        unmatched_returns
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]},
        %% Not test/greet, the Gleam tests' generated service, which gleam
        %% builds.
        {extra_src_dirs, [{"test", [{recursive, false}]}]}
    ]}
]}.
