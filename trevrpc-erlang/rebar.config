{minimum_otp_vsn, "29"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_untyped_record
]}.

{deps, [
    {quic, "~> 2.7.0"},
    {h2, "~> 0.17.0"},
    %% The hex packages of erlang_h1 and erlang_ws; their applications are h1
    %% and ws.
    {h1, "~> 0.11.0", {pkg, erlang_h1}},
    {ws, "~> 0.5.0", {pkg, erlang_ws}}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        missing_return,
        unmatched_returns
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]}
    ]}
]}.
