{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

%% gpb generates the message modules; the escript carries it.
{deps, [{gpb, "~> 5.0.0"}]}.

{escript_name, "protoc-gen-trevrpc-erlang"}.
{escript_main_app, protoc_gen_trevrpc_erlang}.
{escript_incl_apps, [gpb]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        missing_return,
        unmatched_returns
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]}
    ]}
]}.
