{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

%% trevrpc comes from _checkouts/trevrpc, a link to the runtime next door.
{deps, [trevrpc]}.

%% gpb leaves functions it does not use in the message modules.
{xref_ignores, [interop_pb, compressed_pb]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
