{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

%% trevrpc comes from _checkouts/trevrpc, a link to the runtime next door, and
%% qmux from _checkouts/qmux. rebar3 takes trevrpc's dependencies from its
%% rebar.lock, which cannot lock qmux, a checkout there too.
{deps, [trevrpc, qmux]}.

%% gpb leaves functions it does not use in the message modules.
{xref_ignores, [interop_pb, compressed_pb, unreliable_pb]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% qmux is a checkout of trevrpc's, which the PLT leaves out by itself.
{dialyzer, [{plt_extra_apps, [qmux]}]}.

{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]}]}.
